  "scripts": {
    "desktop:dev": "bun run --filter mindwtr dev",
    "desktop:web": "bun run --filter mindwtr dev:vite",
    "desktop:build": "bun run --filter mindwtr build",
    "desktop:web:build": "bun run --filter mindwtr build:vite",
    "test": "bun run --filter @mindwtr/core test && bun run --filter mindwtr test",
    "verify": "bun run typecheck && bun run lint:all && bun run test",
    "test:perf": "bun run --filter @mindwtr/core test:perf && MINDWTR_PERF_TEST=1 bun --cwd apps/desktop test src/components/views/ListView.performance.test.tsx src/components/views/TimelineView.performance.test.tsx",
    "lint:core": "bun run --filter @mindwtr/core lint",
    "lint:desktop": "bun run --filter mindwtr lint",
    "lint:all": "bun run lint:core && bun run lint:desktop",
    "typecheck": "bun run typecheck:core && bun run typecheck:desktop",
    "typecheck:core": "bun run --filter @mindwtr/core typecheck",
    "typecheck:desktop": "bunx tsc --noEmit -p apps/desktop/tsconfig.json",
    "schema:check": "bun run scripts/check-synced-field-parity.ts",
    "native:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:perf-tools": "bun test scripts/performance",
    "perf:web": "node scripts/performance/web-startup.mjs",
    "perf:native": "node scripts/performance/native-desktop.mjs",
    "perf:storage": "bun scripts/performance/storage-sync.ts",
    "test:reliability": "bun scripts/performance/reliability.ts",
    "test:settings-browser": "node scripts/performance/settings-discoverability.mjs",
    "perf:compare": "node scripts/performance/compare.mjs",
    "test:e2e": "playwright test",
    "i18n:check": "bun run scripts/i18n-locale-parity.ts --check",
    "docs:check-readme": "bun run scripts/check-readme-heading-parity.ts",
    "mindwtr:cli": "bun run scripts/mindwtr-cli.ts --",
    "mindwtr:api": "bun run scripts/mindwtr-api.ts --",
    "set-version": "bun run scripts/set-version.ts"
  },
